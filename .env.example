# Chat mode auth (Mode 4)
JARVIS_PWA_PASSWORD=
JARVIS_PWA_SESSION_SECRET=

# Anthropic — used by Talk mode + Chat mode (in mock gateway mode)
ANTHROPIC_API_KEY=

# Whisper (Talk + Ambient modes)
OPENAI_API_KEY=

# ElevenLabs (Talk mode)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Discord (Ambient mode action digest)
DISCORD_BOT_TOKEN=
DISCORD_JARVIS_CHANNEL_ID=
DISCORD_VOICE_MEMO_CHANNEL_ID=

# Chat mode — gateway to the main Jarvis stack
# mode: "mock" (local dev, calls Anthropic directly)
#       "relay" (Mac Mini, POSTs to the gateway)
JARVIS_GATEWAY_MODE=mock
JARVIS_GATEWAY_URL=http://127.0.0.1:18789
JARVIS_GATEWAY_TOKEN=
